---
import Icon from "./Icon.astro";
import perfil from "../data/perfil.json";
import {
	fetchContributions,
	heatmapHtml,
	totalLabel,
	usernameFrom,
} from "../lib/github";

// Se consulta al compilar (para que la página nunca salga vacía)
// y el navegador vuelve a pedir los datos al abrirla, así queda al día.
const { links } = perfil;
const githubUser = usernameFrom(perfil.links.github);
const contrib = await fetchContributions(githubUser);
---

<aside class="sidebar">
	<div class="contact-box">
		<span class="paper" aria-hidden="true"></span>
		<p>encuéntrame aquí</p>
		<nav aria-label="Redes y contacto">
			<a
				aria-label="GitHub"
				href={links.github}
				rel="noreferrer"
				target="_blank"
			>
				<Icon type="github" />
			</a>
			<a
				aria-label="LinkedIn"
				href={links.linkedin}
				rel="noreferrer"
				target="_blank"
			>
				<Icon type="linkedin" />
			</a>
			<a aria-label="Correo" href={`mailto:${links.email}`}>
				<Icon type="mail" />
			</a>
		</nav>
		<a class="cv-button" href={links.cv} download>
			<Icon type="download" />
			Descargar CV
		</a>
	</div>

	<section class="calendar-card glass-panel">
		<span class="paper" aria-hidden="true"></span>
		<div class="panel-heading">
			<span>calendario</span>
			<span data-calendar-label></span>
		</div>
		<div class="weekday-row">
			{["L", "M", "X", "J", "V", "S", "D"].map((d) => (
				<span>{d}</span>
			))}
		</div>
		<div
			class="calendar-grid"
			data-calendar-grid
			data-tz={perfil.calendario.zonaHoraria}
			data-default={perfil.calendario.porDefecto}
		></div>
		<p class="calendar-note" aria-live="polite">
			<span class="tiny-star">✦</span>
			<span data-cal-note-label>hoy</span>:{" "}
			<span data-cal-note>{perfil.calendario.porDefecto}</span>
		</p>
	</section>

	<section class="activity-card glass-panel">
		<span class="paper" aria-hidden="true"></span>
		<div class="panel-heading">
			<span>actividad en github</span>
			<a
				href={perfil.links.github}
				target="_blank"
				rel="noreferrer"
				data-gh-total
			>
				{contrib ? totalLabel(contrib.total) : "ver perfil ↗"}
			</a>
		</div>
		<div
			class="heatmap"
			role="img"
			aria-label="Mapa de contribuciones en GitHub del último año"
			data-gh-heatmap
			data-gh-user={githubUser}
			set:html={contrib ? heatmapHtml(contrib.days) : ""}
		/>
		<div class="heatmap-legend">
			<span>menos</span>
			{[0, 1, 2, 3, 4].map((level) => (
				<i class={`level-${level}`}></i>
			))}
			<span>más</span>
		</div>
	</section>
</aside>

<script>
	import { fetchContributions, heatmapHtml, totalLabel } from "../lib/github";

	// Actividad de GitHub: refresca con los datos más recientes al abrir la página
	const heatmap = document.querySelector<HTMLElement>("[data-gh-heatmap]");
	const total = document.querySelector("[data-gh-total]");
	if (heatmap?.dataset.ghUser) {
		fetchContributions(heatmap.dataset.ghUser).then((data) => {
			if (!data) return;
			heatmap.innerHTML = heatmapHtml(data.days);
			if (total) total.textContent = totalLabel(data.total);
		});
	}

	// Calendario: mes actual (hora de Chile) + notas diarias guardadas desde /hoy
	const MESES = [
		"ene",
		"feb",
		"mar",
		"abr",
		"may",
		"jun",
		"jul",
		"ago",
		"sep",
		"oct",
		"nov",
		"dic",
	];
	const label = document.querySelector("[data-calendar-label]");
	const grid = document.querySelector<HTMLElement>("[data-calendar-grid]");
	const noteLabel = document.querySelector("[data-cal-note-label]");
	const noteText = document.querySelector("[data-cal-note]");

	if (label && grid && noteLabel && noteText) {
		const tz = grid.dataset.tz || "America/Santiago";
		const porDefecto = grid.dataset.default || "";
		// "Hoy" según la zona horaria configurada, en formato YYYY-MM-DD
		const hoy = new Intl.DateTimeFormat("en-CA", { timeZone: tz }).format(
			new Date(),
		);
		const [y, m, d] = hoy.split("-").map(Number);
		const mesKey = hoy.slice(0, 7);
		label.textContent = `${String(m).padStart(2, "0")} / ${y}`;

		const offset = (new Date(y, m - 1, 1).getDay() + 6) % 7; // lunes = 0
		const daysInMonth = new Date(y, m, 0).getDate();
		const daysPrev = new Date(y, m - 1, 0).getDate();
		const cells = Math.ceil((offset + daysInMonth) / 7) * 7;
		const dayEls = new Map<string, HTMLElement>();

		for (let i = 0; i < cells; i++) {
			const span = document.createElement("span");
			const day = i - offset + 1;
			if (day < 1) {
				span.textContent = String(daysPrev + day);
				span.className = "muted";
			} else if (day > daysInMonth) {
				span.textContent = String(day - daysInMonth);
				span.className = "muted";
			} else {
				span.textContent = String(day);
				if (day === d) span.classList.add("today");
				dayEls.set(`${mesKey}-${String(day).padStart(2, "0")}`, span);
			}
			grid.appendChild(span);
		}

		let notas: Record<string, string> = {};
		// Cambia la nota del día con una animación corta. No usa view transition:
		// esa capa tapa la página, el día pierde el hover y la nota parpadea en bucle.
		const nota = noteText.parentElement!;
		const ponerNota = (etiqueta: string, texto: string) => {
			if (noteLabel.textContent === etiqueta && noteText.textContent === texto) return;
			noteLabel.textContent = etiqueta;
			noteText.textContent = texto;
			nota.classList.remove("nota-cambia");
			void nota.offsetWidth; // reinicia la animación
			nota.classList.add("nota-cambia");
		};
		const mostrarHoy = () => ponerNota("hoy", notas[hoy] || porDefecto);
		const mostrar = (fecha: string) => {
			const dia = Number(fecha.slice(8));
			ponerNota(fecha === hoy ? "hoy" : `${dia} ${MESES[m - 1]}`, notas[fecha]);
		};

		fetch(`/api/hoy?mes=${mesKey}`, { cache: "no-store" })
			.then((r) => (r.ok ? r.json() : null))
			.then((data) => {
				if (!data?.notas) return;
				notas = data.notas;
				mostrarHoy();
				for (const [fecha, texto] of Object.entries(notas)) {
					const el = dayEls.get(fecha);
					if (!el || !texto) continue;
					el.classList.add("has-note");
					el.tabIndex = 0;
					el.title = texto;
					el.setAttribute("role", "button");
					el.setAttribute(
						"aria-label",
						`${Number(fecha.slice(8))} ${MESES[m - 1]}: ${texto}`,
					);
					el.addEventListener("mouseenter", () => mostrar(fecha));
					el.addEventListener("focus", () => mostrar(fecha));
					el.addEventListener("click", () => mostrar(fecha));
					el.addEventListener("mouseleave", mostrarHoy);
					el.addEventListener("blur", mostrarHoy);
				}
			})
			.catch(() => {
				// Sin la función (por ejemplo, en `npm run dev`) se queda la frase por defecto
			});
	}
</script>
