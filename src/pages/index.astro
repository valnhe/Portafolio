---
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import TabsPanel from '../components/TabsPanel.astro';
import Sidebar from '../components/Sidebar.astro';
import Notebook from '../components/Notebook.astro';
import Player from '../components/Player.astro';
import perfil from '../data/perfil.json';
---

<Layout>
	<main class="site-shell" data-shell>
		<div class="ambient ambient-one"></div>
		<div class="ambient ambient-two"></div>

		<section class="desktop-window" data-window>
			<header class="titlebar">
				<div class="brand">
					<div class="cat-mark" aria-hidden="true">
						<span>·</span><span>ᴗ</span><span>·</span>
					</div>
					<span>{perfil.usuario}</span>
					<span class="online-label">online</span>
				</div>
				<div class="window-actions" aria-label="Controles de ventana">
					<button aria-label="Minimizar" data-minimize><span class="minimize-symbol"></span></button>
					<button aria-label="Maximizar" data-maximize><span class="maximize-symbol"></span></button>
					<button aria-label="Cerrar" class="close-button" data-close><span></span></button>
				</div>
			</header>

			<div class="window-body">
				<Intro />
				<div class="content-grid">
					<TabsPanel />
					<Sidebar />
				</div>
			</div>

			<footer class="statusbar">
				<span><span class="status-dot"></span> {perfil.estado.izquierda}</span>
				<span data-notice>{perfil.estado.centro}</span>
				<a href={perfil.estado.repositorio} target="_blank" rel="noreferrer">ver código en github ↗</a>
			</footer>
		</section>

		<Player />
	</main>

	<Notebook />
</Layout>

<script>
	const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;

	// Pestañas
	const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]');
	function activate(tab: HTMLButtonElement) {
		tabs.forEach((t) => {
			const on = t === tab;
			t.classList.toggle('active', on);
			t.setAttribute('aria-selected', String(on));
			t.tabIndex = on ? 0 : -1;
			$(`#panel-${t.dataset.tab}`).hidden = !on;
		});
	}
	const fromHash = [...tabs].find((t) => `#${t.dataset.tab}` === location.hash);
	if (fromHash) activate(fromHash);
	tabs.forEach((tab, i) => {
		tab.addEventListener('click', () => {
			activate(tab);
			history.replaceState(null, '', `#${tab.dataset.tab}`);
		});
		tab.addEventListener('keydown', (e) => {
			const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
			if (!dir) return;
			const next = tabs[(i + dir + tabs.length) % tabs.length];
			activate(next);
			next.focus();
		});
	});

	// Subpestañas de trayectoria (laboral / académica)
	const subtabs = document.querySelectorAll<HTMLButtonElement>('[data-subtab]');
	function activateSub(tab: HTMLButtonElement) {
		subtabs.forEach((t) => {
			const on = t === tab;
			t.classList.toggle('active', on);
			t.setAttribute('aria-selected', String(on));
			t.tabIndex = on ? 0 : -1;
			$(`#subpanel-${t.dataset.subtab}`).hidden = !on;
		});
	}
	subtabs.forEach((tab, i) => {
		tab.addEventListener('click', () => activateSub(tab));
		tab.addEventListener('keydown', (e) => {
			const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
			if (!dir) return;
			const next = subtabs[(i + dir + subtabs.length) % subtabs.length];
			activateSub(next);
			next.focus();
		});
	});

	// Ventana: maximizar, minimizar (agenda secreta) y el botón cerrar que se escapa
	const win = $('[data-window]');
	const maxBtn = $('[data-maximize]');
	maxBtn.addEventListener('click', () => {
		const on = win.classList.toggle('maximized');
		// En celulares el cambio es instantáneo; un "pop" corto da la sensación de movimiento
		win.classList.remove('pop');
		void win.offsetWidth;
		win.classList.add('pop');
		maxBtn.setAttribute('aria-label', on ? 'Restaurar tamaño' : 'Maximizar');
	});

	const shell = $('[data-shell]');
	const notebook = $('[data-notebook]');
	$('[data-minimize]').addEventListener('click', () => {
		shell.hidden = true;
		notebook.hidden = false;
		window.scrollTo(0, 0);
	});
	$('[data-restore]').addEventListener('click', () => {
		notebook.hidden = true;
		shell.hidden = false;
	});

	const closeBtn = $('[data-close]');
	const notice = $('[data-notice]');
	let moves = 0;
	// Mientras la ventana cambia de tamaño, la X pasa bajo el puntero:
	// ese "mouseenter" no cuenta como intento de cerrar.
	let resizing = false;
	const dodge = () => {
		if (resizing) return;
		closeBtn.classList.remove(`dodge-${moves}`);
		moves = (moves + 1) % 5;
		if (moves) closeBtn.classList.add(`dodge-${moves}`);
		notice.textContent = 'todavía no me puedes cerrar';
	};
	closeBtn.addEventListener('click', dodge);
	closeBtn.addEventListener('mouseenter', dodge);

	// Al maximizar o restaurar, la X vuelve a su lugar y no se escapa durante la animación
	const noticeDefault = notice.textContent;
	let resizeTimer: ReturnType<typeof setTimeout>;
	maxBtn.addEventListener('click', () => {
		closeBtn.classList.remove(`dodge-${moves}`);
		moves = 0;
		notice.textContent = noticeDefault;
		resizing = true;
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(() => (resizing = false), 450);
	});

	// Reproductor
	const player = $('[data-player]');
	const closePlayer = () => (player.hidden = true);
	$('[data-open-player]').addEventListener('click', () => {
		player.hidden = false;
		player.querySelector<HTMLButtonElement>('.player-backdrop')?.focus(); // clic afuera o Escape para cerrar
	});
	document.querySelectorAll('[data-close-player]').forEach((b) => b.addEventListener('click', closePlayer));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !player.hidden) closePlayer();
	});
</script>
