---
import Icon from './Icon.astro';
import perfil from '../data/perfil.json';

// **texto** → subrayado rosa, __texto__ → subrayado azul
const escape = (s: string) =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const introHtml = escape(perfil.intro)
	.replace(/\*\*(.+?)\*\*/g, '<span class="text-highlight pink">$1</span>')
	.replace(/__(.+?)__/g, '<span class="text-highlight blue">$1</span>');

const { links } = perfil;
---

<section class="intro-card glass-panel">
	<span class="paper" aria-hidden="true"></span>
	<button aria-label="Mostrar canción actual" class="music-peek" data-open-player>
		<span class="music-peek-disc"></span>
		<span data-np-peek>currently <strong>listening</strong></span>
	</button>

	<div class="intro-copy">
		<p class="eyebrow">{perfil.saludo}</p>
		<h1>{perfil.titulo}</h1>
		<p class="intro-role"><span class="paper" aria-hidden="true"></span>{perfil.rol}</p>
		<p class="intro-text" set:html={introHtml} />
	</div>

	<div class="contact-box">
		<span class="paper" aria-hidden="true"></span>
		<p>encuéntrame aquí</p>
		<nav aria-label="Redes y contacto">
			<a aria-label="GitHub" href={links.github} rel="noreferrer" target="_blank"><Icon type="github" /></a>
			<a aria-label="LinkedIn" href={links.linkedin} rel="noreferrer" target="_blank"><Icon type="linkedin" /></a>
			<a aria-label="Correo" href={`mailto:${links.email}`}><Icon type="mail" /></a>
		</nav>
		<a class="cv-button" href={links.cv} download>
			<Icon type="download" />
			descargar CV
		</a>
		<span class="available">
			<span class="status-dot"></span>
			{perfil.disponible}
		</span>
	</div>
</section>
