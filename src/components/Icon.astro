---
interface Props {
	type: 'github' | 'linkedin' | 'mail' | 'download';
	size?: number;
}
const { type, size = 18 } = Astro.props;
---

<svg aria-hidden="true" fill="none" height={size} width={size} viewBox="0 0 24 24">
	{type === 'github' && (
		<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7.4A5.8 5.8 0 0 0 19.3 3 5.4 5.4 0 0 0 19.1 0S17.9-.4 15 1.5a14 14 0 0 0-7 0C5.1-.4 3.9 0 3.9 0a5.4 5.4 0 0 0-.2 3A5.8 5.8 0 0 0 2.2 7c0 5.8 3.5 7 6.8 7.4A4.8 4.8 0 0 0 8 18v4M8 19c-3 .9-3-1.5-4.2-2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
	)}
	{type === 'linkedin' && (
		<>
			<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6ZM2 9h4v12H2z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" />
			<path d="M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" stroke="currentColor" stroke-width="1.7" />
		</>
	)}
	{type === 'mail' && (
		<>
			<rect height="16" rx="3" stroke="currentColor" stroke-width="1.7" width="20" x="2" y="4" />
			<path d="m3 6 9 7 9-7" stroke="currentColor" stroke-linejoin="round" stroke-width="1.7" />
		</>
	)}
	{type === 'download' && (
		<path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" />
	)}
</svg>
