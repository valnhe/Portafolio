---
import { SEO } from 'astro-seo';
import perfil from '../data/perfil.json';
import '../styles/global.css';

const { titulo = perfil.seo.titulo, noindex = false } = Astro.props as { titulo?: string; noindex?: boolean };
---

<!doctype html>
<html lang="es">
	<head>
		<SEO
			title={titulo}
			description={perfil.seo.descripcion}
			charset="UTF-8"
			noindex={noindex}
			nofollow={noindex}
			openGraph={{
				basic: {
					title: titulo,
					type: 'website',
					image: new URL('/assets/cat-clouds.png', perfil.seo.url).href,
					url: perfil.seo.url,
				},
			}}
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/1F338.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<slot />
	</body>
</html>
