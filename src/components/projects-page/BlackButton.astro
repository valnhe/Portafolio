---
const {demo="#",code="#"} = Astro.props;
---
<nav class="flex justify-stretch text-sm flex-wrap">
    <a href={demo} target="_blank" class="bg-primarycolor py-1.5 px-5 rounded-lg text-white shadow-sm font-semibold cursor-pointer border-2 border-transparent mr-3">
        {demo === "https://teachear.feriadesoftware.cl/" ? "Más sobre Teachear" : "Demo"}
    </a>
    <a href={code} target="_blank" class="border-2 border-primarycolor py-1.5 px-5 rounded-lg text-primarycolor shadow-sm font-semibold cursor-pointer hover:bg-primarycolor hover:text-white transition-colors ease-in-out duration-500 delay-100">
        {code === "https://www.instagram.com/teachear.cl/" ? "Instagram" : "Código"}
    </a>
</nav>